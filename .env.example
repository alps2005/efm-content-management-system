# Copy this file to .env and fill in real values. .env is gitignored.

# Base URL of the Agro Vivero backend API (see docs/api_usage.md)
VITE_API_BASE_URL=http://localhost:3000/api

# Google OAuth Client ID (Google Cloud Console > APIs & Services > Credentials)
# Authorized JavaScript origin must include http://localhost:5173 for local dev.
# Note: Google login is cosmetic only — the backend has no Google OAuth endpoint,
# so it does not issue an API token and cannot access protected routes.
VITE_GOOGLE_CLIENT_ID=

# Local admin credentials (bypasses the backend /auth/login call)
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=
