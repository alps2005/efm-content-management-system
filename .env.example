# Copy this file to .env and fill in real values. .env is gitignored.

# Offline admin login (client-side check, no backend)
VITE_ADMIN_EMAIL=admin@ecotecfloramedica.com
VITE_ADMIN_PASSWORD=changeme

# Google OAuth Client ID (Google Cloud Console > APIs & Services > Credentials)
# Authorized JavaScript origin must include http://localhost:5173 for local dev.
VITE_GOOGLE_CLIENT_ID=
